---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Tarlo Electrical Connections — Northern Beaches Electrician',
  description = 'Harry Betts, local licensed electrician available 24/7 across the Northern Beaches, eastern suburbs and lower north shore. Switchboards, LED lighting, power points, smoke alarms, ceiling fans, EV chargers and fault finding. Free quotes.',
} = Astro.props;
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#fec20e">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;700&display=swap">
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <slot />
  <script>import '../scripts/main.js';</script>
</body>
</html>
