---
import DotField from './DotField.astro';
import { business, trustTicks } from '../data/site';

const faces = [
  { src: '/assets/images/hero-1.jpg', alt: 'Stripping wires at the bench', pos: '40% 60%' },
  { src: '/assets/images/hero-2.jpg', alt: 'Harry Betts on site', pos: '50% 22%' },
  { src: '/assets/images/hero-3.jpg', alt: 'Testing a switchboard', pos: '55% 55%' },
];
---
<section class="hero" id="top" data-hero data-dots>
  <div class="dots-bg hero__tint" aria-hidden="true"></div>
  <DotField />
  <div class="container hero__content">
    <ul class="faces" aria-label="Harry on the job">
      {faces.map((f) => (
        <li><img src={f.src} alt={f.alt} width="104" height="104" style={`object-position: ${f.pos}`}></li>
      ))}
    </ul>
    <h1 data-hero-in="1">One electrician. Every job done right.</h1>
    <p class="hero__intro" data-hero-in="2">{business.name} is Harry, a local licensed electrician. Small fixes or big projects, he does it all across the Northern Beaches, lower north shore and eastern suburbs, 24/7.</p>
    <div class="actions" data-hero-in="3">
      <a class="pill pill--lg" href="#contact">Get a quote <img src="/assets/icons/arrows.svg" width="14" height="14" alt=""></a>
      <a class="pill pill--lg pill--outline" href="#contact">Contact us</a>
    </div>
    <ul class="trust" data-hero-in="4">
      {trustTicks.map((t) => (
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1c1c1c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{t}</li>
      ))}
    </ul>
  </div>
</section>
