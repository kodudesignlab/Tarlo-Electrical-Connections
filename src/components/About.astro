---
import { business, stats } from '../data/site';
---
<section class="section" id="about">
  <div class="container split about">
    <div class="split__a about__text" data-reveal>
      <div class="section-head__title">
        <p class="eyebrow">About Harry</p>
        <h2 class="h2">Same bloke, every job</h2>
      </div>
      <div class="about__body">
        <p>I'm Harry Betts. I've been an electrician for {business.yearsInTrade} years, and I started Tarlo {business.yearsInBusiness} years ago because I wanted to do something different and run my own show. It's just me, so when you book a job, I'm the one who turns up, does the work and signs off on it.</p>
        <p>I'm local, family-oriented and available 24/7. Customers tell me what they like most is the communication, turning up on time and leaving the place clean. You'll get a free quote before I start.</p>
      </div>
      <dl class="stats">
        {stats.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
      </dl>
      <div><a class="pill pill--lg" href="#contact">Contact us today <img src="/assets/icons/arrows.svg" width="14" height="14" alt=""></a></div>
    </div>
    <figure class="photo" data-reveal>
      <img src="/assets/images/harry.jpg" alt="Harry Betts crouched on site, working on cabling" width="500" height="750" loading="lazy">
      <figcaption>Harry Betts — Owner &amp; electrician</figcaption>
    </figure>
  </div>
</section>
