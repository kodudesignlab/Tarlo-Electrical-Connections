---
import DotField from './DotField.astro';
import { business, services, telHref, smsHref, web3formsKey } from '../data/site';

const chips = [...services.map((s) => s.name), 'Something else'];
---
<section class="section section--yellow has-dots" id="contact" data-dots>
  <DotField />
  <div class="container split">
    <div class="split__a contact__text" data-reveal>
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="h2">Let's sort it out.</h2>
        <p class="lede">Call, text or send the form. I'm available 24/7 for emergencies, and quotes are always free. Photos help: I can often price straight off them.</p>
      </div>
      <dl class="details">
        <div><dt>Call</dt><dd><a href={telHref(business.phone)}>{business.phone}</a></dd></div>
        <div><dt>Text</dt><dd><a href={smsHref(business.phone)}>{business.phone}</a></dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a></dd></div>
        <div><dt>Hours</dt><dd>{business.hours}</dd></div>
        <div><dt>Area</dt><dd>{business.area}</dd></div>
      </dl>
    </div>
    <!-- Sent via Web3Forms to service@tarloelectrical.com.au (main.js submits it with fetch; the action is the no-JS fallback). -->
    <form class="split__b form" data-form data-phone={business.phone} data-reveal novalidate action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value={web3formsKey}>
      <input type="hidden" name="subject" value="New enquiry from the Tarlo website">
      <input type="hidden" name="from_name" value="Tarlo website">
      <!-- Spam trap: real people never see or fill this -->
      <input type="checkbox" name="botcheck" class="form__trap" tabindex="-1" autocomplete="off" aria-hidden="true">
      <fieldset class="form__full">
        <legend>What do you need? <span>Pick any</span></legend>
        <div class="chips" data-chips>
          {chips.map((c) => <button class="chip" type="button" aria-pressed="false">{c}</button>)}
        </div>
        <input type="hidden" name="services" data-chips-value>
      </fieldset>
      <label class="field">Name<input type="text" name="name" autocomplete="name" required></label>
      <label class="field">Phone<input type="tel" name="phone" autocomplete="tel" required></label>
      <label class="field">Email<input type="email" name="email" autocomplete="email"></label>
      <label class="field">Suburb<input type="text" name="suburb" autocomplete="address-level2"></label>
      <label class="field form__full">About the job<textarea name="message" rows="5"></textarea></label>
      <div class="form__full form__foot">
        <span class="form__note" data-form-note aria-live="polite">Quotes are always free.</span>
        <button class="pill pill--lg pill--dark" type="submit">Send enquiry <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></button>
      </div>
    </form>
  </div>
</section>
